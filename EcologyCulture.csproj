    <AssemblyName>BaiyeEcologyCulture</AssemblyName><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);GAME_HOST</DefineConstants>
    <GameManaged Condition="'$(GameManaged)' == ''">D:\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
